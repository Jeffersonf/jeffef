---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'jefferson - caderno',
  description = 'Um pequeno caderno pessoal de notas, cenas, trabalho e vida comum.'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const themeColor = '#f8fafb';
const base = '/jeffef/';
const url = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      const storedTheme = localStorage.getItem('jeffef-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = storedTheme || (prefersDark ? 'dark' : 'light');
    </script>
    <title>{title}</title>
  </head>
  <body>
    <header class="shell topbar">
      <a class="brand revoada-brand" href={url('/')}>
        <img class="brand-bird" src={url('/icons/revoada.svg')} alt="Revoada" width="26" height="26" />
        <span>jefferson <small class="brand-tag">· revoada</small></span>
      </a>
      <button class="theme-toggle" type="button" aria-label="Alternar tema" data-theme-toggle>
        <span class="theme-icon theme-icon-sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <circle cx="12" cy="12" r="4.25"></circle>
            <path d="M12 2.75v2.1M12 19.15v2.1M4.2 4.2l1.48 1.48M18.32 18.32l1.48 1.48M2.75 12h2.1M19.15 12h2.1M4.2 19.8l1.48-1.48M18.32 5.68l1.48-1.48"></path>
          </svg>
        </span>
        <span class="theme-icon theme-icon-moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <path d="M20.4 14.55A7.85 7.85 0 0 1 9.45 3.6a8.7 8.7 0 1 0 10.95 10.95Z"></path>
          </svg>
        </span>
        <span class="theme-icon theme-icon-tripnext" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <path d="M12 2.8l1.35 4.5a4.8 4.8 0 0 0 3.3 3.3l4.55 1.4-4.55 1.4a4.8 4.8 0 0 0-3.3 3.3L12 21.2l-1.35-4.5a4.8 4.8 0 0 0-3.3-3.3L2.8 12l4.55-1.4a4.8 4.8 0 0 0 3.3-3.3L12 2.8Z"></path>
          </svg>
        </span>
        <span class="theme-text">tema</span>
      </button>
      <nav class="nav" aria-label="Navegacao principal">
        <a href={url('/notas/')}>notas</a>
        <a href={url('/cenas/')}>cenas</a>
        <a href={url('/projetos/')}>projetos</a>
        <a href={url('/agora/')}>agora</a>
        <a href={url('/sobre/')}>sobre</a>
      </nav>
    </header>

    <slot />

    <footer class="footer">
      <div class="shell">
        <span><strong>jeffef.dev</strong>, ninho central & caderno pessoal</span>
        <span>feito com calma · a revoada 🪶</span>
      </div>
    </footer>
    <script is:inline>
      const button = document.querySelector('[data-theme-toggle]');
      const syncThemeButton = () => {
        if (!button) return;
        const theme = document.documentElement.dataset.theme || 'light';
        const labels = { light: 'claro', dark: 'escuro', tripnext: 'tripnext' };
        button.setAttribute('aria-label', `Tema atual: ${labels[theme]}. Alternar tema`);
        button.querySelector('.theme-text').textContent = labels[theme];
      };
      syncThemeButton();
      button?.addEventListener('click', () => {
        const themes = ['light', 'dark', 'tripnext'];
        const current = document.documentElement.dataset.theme || 'light';
        const next = themes[(themes.indexOf(current) + 1) % themes.length];
        document.documentElement.dataset.theme = next;
        localStorage.setItem('jeffef-theme', next);
        syncThemeButton();
      });
    </script>
  </body>
</html>
