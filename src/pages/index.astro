---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { accentForKind, dateParts, getPublishedNotas, noteSlug, resolveAssetPath } from '../lib/notas';

const home = await getEntry('site', 'home');
if (!home) throw new Error('Missing site/home.json');
const agora = await getEntry('site', 'agora');

const data = home.data;
const agoraData = agora?.data;
const notas = await getPublishedNotas();
const destaques = notas.filter((nota) => nota.data.photo).slice(0, 4);
const heroPhoto = destaques[0];
const secondaryPhotos = destaques.slice(1);
const recentes = notas.slice(0, 6);
const nowCards = agoraData?.cards?.slice(0, 3) ?? [];
const base = '/jeffef/';
const url = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const projects = [
  {
    id: 'revoada',
    name: 'Revoada',
    icon: url('/icons/revoada.svg'),
    folder: 'jeffef-site',
    href: url('/'),
    status: 'ninho central',
    role: 'Hub Pessoal & Caderno',
    body: 'O ponto de pouso, repouso e partida de todas as aves. Onde as ideias nascem, registram-se e alçam voo.',
    kind: 'hub'
  },
  {
    id: 'harpia',
    name: 'Harpia',
    icon: url('/icons/harpia.svg'),
    folder: 'radar-imoveis',
    href: url('/projetos/radar-imoveis/'),
    status: 'ativo',
    role: 'Radar de Imóveis',
    body: 'A visão mais aguçada das Américas. Escaneia o território de cima e detecta oportunidades cirúrgicas no mercado.',
    kind: 'radar'
  },
  {
    id: 'kestrel',
    name: 'Kestrel',
    icon: url('/icons/kestrel.svg'),
    folder: 'teamlucaofuturo',
    href: url('/projetos/arena/'),
    status: 'ativo',
    role: 'SaaS White-Label Core',
    body: 'O pequeno falcão ágil que paira estático contra fortes ventos. Motor multi-tenant para arenas esportivas e comunidades.',
    kind: 'saas'
  },
  {
    id: 'falcao',
    name: 'Falcão',
    icon: url('/icons/falcao.svg'),
    folder: 'finanza-auto',
    href: url('/projetos/finanza-auto/'),
    status: 'ativo',
    role: 'Telemetria & Custos',
    body: 'O animal mais veloz da Terra. Alta performance, registro instantâneo de abastecimentos, consumo (km/l) e saúde preventiva.',
    kind: 'auto'
  },
  {
    id: 'tuiuiu',
    name: 'Tuiuiú',
    icon: url('/icons/tuiuiu.svg'),
    folder: 'finanza-next',
    href: url('/projetos/finanza-next/'),
    status: 'ativo',
    role: 'Gestão Patrimonial',
    body: 'A maior envergadura de asas das planícies. Estrutura sólida, elegância e sustentação estável para patrimônio familiar.',
    kind: 'finanças'
  }
];

const chipColor = {
  blue: 'var(--blue)',
  green: 'var(--green)',
  rose: 'var(--rose)',
  gold: 'var(--gold)',
  sky: 'var(--sky)'
};

const emphasisClosing = data.closing?.replace('memória própria', '<em>memória própria</em>');
---

<BaseLayout title={data.title} description={data.description}>
  <main>
    <section class="shell hero">
      <div class="hero-copy">
        <h1 set:html={data.heroTitle?.replace('movimento', '<em>movimento</em>')} />
        <p class="lead">{data.heroLead}</p>
        <p class="hero-note">{data.heroNote}</p>
        <div class="status-row" aria-label="Temas atuais do caderno">
          {data.chips.map((chip) => (
            <span class="chip" style={`--chip-c: ${chipColor[chip.color]}`}>{chip.label}</span>
          ))}
        </div>
      </div>
      {heroPhoto && (
        <a class="hero-visual" href={url(`/notas/${noteSlug(heroPhoto.id)}/`)}>
          <figure>
            <img src={resolveAssetPath(heroPhoto.data.photo)} alt={heroPhoto.data.photoAlt ?? ''} />
            <figcaption>
              <span>{heroPhoto.data.place ?? heroPhoto.data.kind}</span>
              <strong>{heroPhoto.data.title}</strong>
            </figcaption>
          </figure>
        </a>
      )}
    </section>

    <section class="shell section" id="cenas">
      <div class="section-head">
        <div>
          <p class="eyebrow">{data.sections?.photos?.eyebrow}</p>
          <h2>{data.sections?.photos?.title}</h2>
        </div>
        <p>{data.sections?.photos?.body}</p>
      </div>

      <div class="section-body">
        {destaques.length > 0 ? (
          <div class:list={['photo-grid', { single: secondaryPhotos.length === 0 }]}>
            {(secondaryPhotos.length > 0 ? secondaryPhotos : destaques).map((nota) => (
              <a class="feature-photo" href={url(`/notas/${noteSlug(nota.id)}/`)}>
                <figure>
                  <img src={resolveAssetPath(nota.data.photo)} alt={nota.data.photoAlt ?? ''} />
                  <figcaption>{nota.data.title}</figcaption>
                </figure>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-state">As cenas vao aparecer aqui quando alguma nota tiver foto.</p>
        )}
        <p class="more-link"><a href={url('/cenas/')}>ver todas as cenas</a></p>
      </div>
    </section>

    <section class="shell section" id="notas">
      <div class="section-head">
        <div>
          <p class="eyebrow">{data.sections?.notes?.eyebrow}</p>
          <h2>{data.sections?.notes?.title}</h2>
        </div>
        <p>{data.sections?.notes?.body}</p>
      </div>

      <div class="section-body">
        {recentes.length > 0 ? (
          <div class="note-list home-note-list">
            {recentes.map((nota) => (
              <a class="note-row" href={url(`/notas/${noteSlug(nota.id)}/`)} style={`--accent: var(--${accentForKind(nota.data.kind)})`}>
                <time class="date-block" datetime={nota.data.date.toISOString()}>
                  <span>{dateParts(nota.data.date).day}</span>
                  <strong>{dateParts(nota.data.date).month}</strong>
                  <small>{dateParts(nota.data.date).year}</small>
                </time>
                <article>
                  <span class="kind">{nota.data.kind}</span>
                  <h3>{nota.data.title}</h3>
                  {nota.data.summary && <p>{nota.data.summary}</p>}
                  <div class="tags">
                    {nota.data.place && <span class="place">{nota.data.place}</span>}
                    {nota.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                </article>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-state">As primeiras notas ainda nao foram publicadas.</p>
        )}

        <p class="more-link"><a href={url('/notas/')}>ver todas as notas</a></p>
      </div>
    </section>

    {nowCards.length > 0 && (
      <section class="shell section home-now" id="em-curso">
        <div class="section-head">
          <div>
            <p class="eyebrow">{agoraData?.sections?.now?.eyebrow}</p>
            <h2>{agoraData?.sections?.now?.title}</h2>
          </div>
          <p>{agoraData?.sections?.now?.body}</p>
        </div>

        <div class="section-body">
          <div class="now-strip">
            {nowCards.map((card) => (
              <article class:list={['now-card', { highlight: card.highlight }]}>
                <span>{card.label}</span>
                <h3>{card.title}</h3>
                {card.body && <p>{card.body}</p>}
              </article>
            ))}
          </div>
          <p class="more-link"><a href={url('/agora/')}>ver agora</a></p>
        </div>
      </section>
    )}

    <section class="shell section" id="projetos">
      <div class="section-head">
        <div>
          <p class="eyebrow">🪶 a revoada</p>
          <h2>ecossistema de projetos</h2>
        </div>
        <p class="manifesto-quote"><em>"Nenhuma ave voa alto demais se voar com as próprias asas, mas ao voar em formação, a revoada corta os céus e vence qualquer tempestade."</em></p>
      </div>

      <div class="section-body">
        <div class="project-grid">
          {projects.map((project) => (
            <a class="project-card bird-card" data-bird={project.id} href={project.href} aria-label={`Conhecer ${project.name}`}>
              <div class="project-card-top">
                <span class="project-kind-badge">{project.kind}</span>
                <strong>{project.status}</strong>
              </div>
              <div class="bird-header">
                <img src={project.icon} alt="" class="bird-badge-icon" width="44" height="44" />
                <div>
                  <h3>{project.name}</h3>
                  <span class="bird-role">{project.role}</span>
                </div>
              </div>
              <p>{project.body}</p>
              <div class="project-card-foot">
                <code>{project.folder}</code>
                <span>conhecer</span>
              </div>
            </a>
          ))}
        </div>
        <p class="more-link"><a href={url('/projetos/')}>ver mapa completo de todos os projetos</a></p>
      </div>
    </section>

    <section class="shell section" id="sobre">
      <div class="section-head">
        <div>
          <p class="eyebrow">{data.sections?.about?.eyebrow}</p>
          <h2>{data.sections?.about?.title}</h2>
        </div>
        <p>{data.sections?.about?.body}</p>
      </div>

      <div class="section-body">
        <div class="profile">
          {data.cards.map((card, index) => (
            <article class:list={['panel', { highlight: card.highlight, wide: index === 0 }]}>
              <span>{card.label}</span>
              <h3>{card.title}</h3>
              {card.body && <p>{card.body}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="shell">
      <p class="closing" set:html={emphasisClosing} />
    </div>
  </main>
</BaseLayout>
