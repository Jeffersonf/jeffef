  { id:'painelure2', name:'Painel URE2', kind:'painel', status:'em uso', color:'teal', tech:['JavaScript','Node.js','HTML/CSS'], pc:'file:///C:/Users/jeffe/painelure2', github:'https://github.com/Jeffersonf/painelure', summary:'Painel operacional para dados, acompanhamento e organização do trabalho da URE.', ready:['Painel em operação','Banco e migrações','Módulos de trabalho','Rotinas de verificação'], roadmap:['Aprimorar indicadores','Simplificar rotinas recorrentes','Documentar operações críticas'] },
  { id:'setechub', name:'Setec Hub', kind:'hub', status:'em construção', color:'amber', tech:['JavaScript','Node.js','Supabase'], pc:'file:///C:/Users/jeffe/setechub', github:'https://github.com/Jeffersonf/painelurelegado', summary:'Hub para centralizar informações, processos e ferramentas da área técnica.', ready:['Frontend e servidor','Integração com Supabase','Sincronização de dados','Testes iniciais'], roadmap:['Consolidar módulos prioritários','Revisar a migração de dados','Publicar a primeira versão estável'] },
  { id:'bandamarcial', name:'Banda Marcial', kind:'site', status:'em construção', color:'rose', tech:['TypeScript','React','CSS'], pc:'file:///C:/Users/jeffe/bandamarcial', github:null, summary:'Presença digital e organização do conteúdo, história e atividades da banda marcial.', ready:['Estrutura local iniciada','Direção geral do site'], roadmap:['Definir identidade e conteúdo','Construir páginas principais','Publicar a primeira versão'] },
  { id:'arena', name:'Arena Futevôlei', kind:'produto', status:'ativo', color:'teal', tech:['JavaScript','Node.js','PWA'], pc:'file:///C:/Users/jeffe/arena-futvolei', github:'https://github.com/Jeffersonf/arena-futvolei', summary:'App leve para escola de futevôlei: alunos, aulas, presenças, pagamentos e recados.', ready:['Gestão de alunos e aulas','Servidor e assets','Auditoria de fluxo e visual','Ambiente de desenvolvimento'], roadmap:['Fechar o fluxo de pagamentos','Melhorar comunicação com alunos','Preparar implantação'] },
  { id:'jeffef', name:'jeffef.dev', kind:'site', status:'caderno aberto', color:'amber', tech:['Astro','TypeScript','CSS'], pc:'file:///C:/Users/jeffe/jeffef-site', github:'https://github.com/Jeffersonf/jeffef', summary:'Caderno pessoal com notas, cenas, contexto e uma visão viva dos projetos.', ready:['Site Astro responsivo','Notas em Markdown','Editor Decap CMS','Temas claro e escuro'], roadmap:['Evoluir a área de projetos','Ampliar o arquivo de notas','Refinar a publicação pelo CMS'] },
  { id:'finanza-next', name:'Finanza Next', kind:'produto', status:'ativo', color:'teal', tech:['Kotlin','Android','Gradle'], pc:'file:///C:/Users/jeffe/finanza-next', github:'https://github.com/Jeffersonf/finanza-next', summary:'Nova geração do ecossistema Finanza, com projetos Android nativos e módulo dedicado a viagens.', ready:['Repositório principal','Base Android em Kotlin','Módulo de viagens','Estrutura de build Gradle'], roadmap:['Consolidar módulos Android','Unificar dados com o Finanza','Preparar distribuição estável'] },
  { id:'finanza-android', name:'Finanza Android Kotlin', kind:'app', status:'em desenvolvimento', color:'teal', tech:['Kotlin','Android','Gradle'], pc:'file:///C:/Users/jeffe/finanza-android-kotlin', github:null, summary:'Implementação Android nativa do Finanza mantida localmente para evolução e paridade visual.', ready:['Projeto Android','Telas em Kotlin','Rotinas de build','Auditoria de paridade visual'], roadmap:['Concluir paridade com a versão web','Integrar sincronização','Gerar versão de distribuição'] },
  { id:'nexttrip', name:'NextTrip', kind:'app', status:'protótipo', color:'rose', tech:['Kotlin','Android','Jetpack'], pc:'file:///C:/Users/jeffe/nexttrip', github:null, summary:'Aplicativo Android para planejar viagens, orçamento, roteiro e checklist em uma experiência de bolso.', ready:['Projeto Kotlin','Protótipo visual','Estrutura Android','Fluxos iniciais da viagem'], roadmap:['Conectar dados persistentes','Completar roteiro e despesas','Preparar primeira versão instalável'] },
  { id:'fisiosaas', name:'FisioSaaS', kind:'produto', status:'em construção', color:'teal', tech:['HTML/CSS','JavaScript','Python'], pc:'file:///C:/Users/jeffe/Downloads/BarbeariaSaaS', github:'https://github.com/Jeffersonf/FisioSaaS', summary:'Sistema SaaS com frontend web e backend Python, atualmente armazenado localmente como BarbeariaSaaS.', ready:['Frontend web','Backend Python','Dependências e ambiente local','Repositório privado'], roadmap:['Alinhar nome e domínio do produto','Consolidar o fluxo principal','Preparar implantação'] },
  { id:'automacao-confirmacao', name:'Automação Confirmação', kind:'automação', status:'local', color:'amber', tech:['Python'], pc:'file:///C:/Users/jeffe/Nova%20pasta%20(2)/AutomacaoConfirmacao', github:null, summary:'Automação em Python para agilizar confirmações e reduzir tarefas repetitivas.', ready:['Projeto local','Dependências Python','Fluxo inicial de automação'], roadmap:['Documentar execução','Adicionar tratamento de falhas','Versionar no GitHub'] },
  { id:'robo-sam', name:'Robô SAM', kind:'automação', status:'local', color:'amber', tech:['Python'], pc:'file:///C:/Users/jeffe/Downloads/Robo%20SAM', github:null, summary:'Robô de automação mantido em Downloads, com ambiente Python e pacote de distribuição arquivado.', ready:['Código local','Dependências Python','Arquivo de backup'], roadmap:['Revisar o fluxo atual','Documentar configuração','Criar repositório próprio'] },
  { id:'odysseus', name:'Odysseus', kind:'experimento', status:'referência', color:'rose', tech:['Python','JavaScript','Node.js'], pc:'file:///C:/Users/jeffe/odysseus/odysseus', github:'https://github.com/pewdiepie-archdaemon/odysseus', summary:'Projeto híbrido Python e JavaScript mantido localmente a partir de um repositório externo.', ready:['Ambiente Python','Aplicação JavaScript','Repositório de origem configurado'], roadmap:['Definir objetivo de uso','Registrar alterações próprias','Decidir entre fork ou referência'] },
  { id:'sisteminha', name:'Sisteminha', kind:'experimento', status:'arquivado', color:'rose', tech:['TypeScript'], pc:null, github:'https://github.com/Jeffersonf/sisteminha', summary:'Experimento em TypeScript preservado no GitHub como parte do histórico de desenvolvimento.', ready:['Código versionado','Base TypeScript','Repositório público'], roadmap:['Documentar a proposta','Revisar dependências','Decidir se será retomado'] },
  { id:'agua-poke', name:'Água Poke', kind:'experimento', status:'arquivado', color:'rose', tech:['Python'], pc:null, github:'https://github.com/Jeffersonf/agua-poke', summary:'Projeto experimental em Python preservado no GitHub.', ready:['Código Python','Histórico versionado','Repositório público'], roadmap:['Adicionar documentação','Revisar funcionamento atual','Manter como arquivo ou retomar'] },
  { id:'portfolio', name:'Portfólio', kind:'site', status:'legado', color:'amber', tech:['TypeScript'], pc:null, github:'https://github.com/Jeffersonf/portfolio', summary:'Versão anterior de portfólio pessoal construída em TypeScript.', ready:['Site versionado','Base TypeScript','Repositório público'], roadmap:['Preservar como referência','Migrar conteúdo relevante','Direcionar para o jeffef.dev'] },
  { id:'cadastro-time', name:'Cadastro Nosso Time', kind:'estudo', status:'privado', color:'amber', tech:['HTML/CSS'], pc:null, github:'https://github.com/Jeffersonf/cadastro-nosso-time', summary:'Projeto privado de cadastro e interface, mantido como exercício e referência.', ready:['Interface em CSS','Repositório privado','Histórico versionado'], roadmap:['Documentar o exercício','Revisar acessibilidade','Arquivar ou incorporar ideias'] },
  { id:'formulario-cadastro', name:'Formulário de Cadastro', kind:'estudo', status:'privado', color:'amber', tech:['HTML'], pc:null, github:'https://github.com/Jeffersonf/formulario-de-cadastro', summary:'Formulário HTML de estudo preservado em repositório privado.', ready:['Estrutura HTML','Fluxo de formulário','Repositório privado'], roadmap:['Revisar validações','Adicionar estilos e acessibilidade','Manter como referência'] },
  { id:'python-alura', name:'Python Alura', kind:'estudo', status:'privado', color:'amber', tech:['Python','Jupyter Notebook'], pc:null, github:'https://github.com/Jeffersonf/Python-Alura', summary:'Cadernos e exercícios de formação em Python realizados na Alura.', ready:['Notebooks de estudo','Exercícios Python','Repositório privado'], roadmap:['Organizar por curso','Adicionar índice de conteúdos','Registrar aprendizados principais'] },
  { id:'forgottenserver', name:'Forgotten Server ORTS', kind:'fork', status:'arquivo', color:'rose', tech:['Lua','C++'], pc:null, github:'https://github.com/Jeffersonf/FORGOTTENSERVER-ORTS', summary:'Fork histórico de servidor Open Tibia, preservado como parte dos primeiros projetos no GitHub.', ready:['Fork público','Código do servidor','Histórico preservado'], roadmap:['Manter como arquivo histórico','Documentar o contexto','Sem desenvolvimento ativo previsto'] }
];
const settings = await getEntry('site', 'project-settings');
const visibleProjects = new Set(settings?.data.visibleProjects ?? allProjects.map(project => project.id));
const projects = allProjects.filter(project => visibleProjects.has(project.id));
const statuses = [...new Set(projects.map(project => project.status))].sort();
const technologies = [...new Set(projects.flatMap(project => project.tech))].sort();
---
<BaseLayout title="projetos — jefferson" description="Projetos, status, entregas e próximos passos de Jefferson.">
  <main class="projects-page">
    <section class="projects-shell projects-hero">
      <div>
        <p class="projects-kicker">painel de bordo</p>
        <h1>Projetos</h1>
        <p>Produtos, ferramentas e experimentos em um só lugar. Abra um cartão para ver o que já está pronto e o que vem depois.</p>
      </div>
      <div class="projects-stats" aria-label="Resumo dos projetos">
        <strong data-project-count>{projects.length}</strong><span>projetos mapeados</span>
      </div>
    </section>

    <section class="projects-shell projects-toolbar" aria-label="Opções de visualização">
      <a class="projects-manage" href="/jeffef/admin/#/collections/site/entries/project-settings" title="Remover ou reorganizar projetos">gerenciar projetos</a>
      <span>visualização</span>
      <div class="view-switch" role="group" aria-label="Visualização dos projetos">
        <button type="button" data-view="cards" title="Cards" aria-label="Visualizar em cards"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="8" rx="1"/><rect x="14" y="3" width="7" height="8" rx="1"/><rect x="3" y="15" width="7" height="6" rx="1"/><rect x="14" y="15" width="7" height="6" rx="1"/></svg></button>
        <button type="button" data-view="large" title="Cards grandes" aria-label="Visualizar em cards grandes"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="8" rx="1"/><rect x="3" y="15" width="18" height="6" rx="1"/></svg></button>
        <button type="button" data-view="lines" title="Linhas" aria-label="Visualizar em linhas"><svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r=".8"/><circle cx="3.5" cy="12" r=".8"/><circle cx="3.5" cy="18" r=".8"/></svg></button>
      </div>
    </section>

    <section class="projects-shell project-filters" aria-label="Filtrar projetos">
      <label class="filter-search"><span>nome do projeto</span><input type="search" data-filter-search placeholder="Buscar projeto pelo nome…" aria-label="Buscar projeto pelo nome" /></label>
      <label><span>status</span><select data-filter-status><option value="">todos</option>{statuses.map(status => <option value={status}>{status}</option>)}</select></label>
      <label><span>tecnologia</span><select data-filter-tech><option value="">todas</option>{technologies.map(tech => <option value={tech}>{tech}</option>)}</select></label>
      <label><span>ordenar</span><select data-filter-sort><option value="recent">mais recentes</option><option value="oldest">mais antigos</option><option value="name">nome A–Z</option></select></label>
      <button type="button" data-filter-clear>limpar</button>
    </section>

    <section class="projects-shell projects-grid" data-project-grid data-view="large" aria-label="Lista de projetos">
      {projects.map((project, index) => (
        <details class={`project-board-card accent-${project.color}`} open={index === 0} data-project={project.id} data-name={project.name} data-summary={project.summary} data-status={project.status} data-tech={project.tech.join('|')} data-date={updates[project.id]?.iso}>
          <summary>
            <div class="project-summary-top"><span class="project-kind">{project.kind}</span><span class="project-status"><i></i>{project.status}</span></div>
            <div class="project-title-row"><div class="project-mark">{String(index + 1).padStart(2,'0')}</div><div><h2><a class="project-page-link" href={`/jeffef/projetos/${project.id}/`}>{project.name}</a></h2><p>{project.summary}</p><div class="project-tech" aria-label="Tecnologias utilizadas">{project.tech.map(item => <span>{item}</span>)}</div><p class="project-updated"><time datetime={updates[project.id]?.iso}>{updates[project.id]?.date}</time><span>{updates[project.id]?.change}</span></p></div></div>
            <span class="project-expand">ver detalhes <b>⌄</b></span>
          </summary>
          <div class="project-detail">
            <div class="project-links">
              {project.pc ? (
                <>
                  <a href={project.pc.replace('file:///', 'vscode://file/')} title="Abrir projeto no VS Code"><span>▣</span> abrir no VS Code</a>
                  <button class="project-copy-path" type="button" data-copy-path={decodeURIComponent(project.pc.replace('file:///', '').replaceAll('/', '\\'))}><span>⧉</span> copiar caminho</button>
                </>
              ) : <span class="link-disabled">Sem cópia local encontrada</span>}
              {project.github ? <a href={project.github} target="_blank" rel="noreferrer"><span>↗</span> GitHub</a> : <span class="link-disabled">GitHub não configurado</span>}
            </div>
            <div class="project-columns">
              <section><h3><span class="done-dot">✓</span> O que está pronto</h3><ul>{project.ready.map(item => <li>{item}</li>)}</ul></section>
              <section><h3><span class="road-dot">→</span> Roadmap</h3><ol>{project.roadmap.map(item => <li>{item}</li>)}</ol></section>
            </div>
            <section class="ideas-box">
              <div><h3>Banco de ideias</h3><p>Rascunhos salvos neste navegador.</p></div>
              <form data-idea-form={project.id}><input name="idea" autocomplete="off" placeholder={`Nova ideia para ${project.name}...`} aria-label={`Nova ideia para ${project.name}`} /><button type="submit" aria-label="Adicionar ideia">+</button></form>
              <ul data-idea-list={project.id}></ul>
            </section>
          </div>
        </details>
      ))}
    </section>
  </main>
  <script is:inline>
    const viewKey = 'jeffef-project-view';
    const grid = document.querySelector('[data-project-grid]');
    const viewButtons = document.querySelectorAll('[data-view]');
    const setView = (view) => {
      grid.dataset.view = view;
      viewButtons.forEach(button => {
        const active = button.dataset.view === view;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      localStorage.setItem(viewKey, view);
    };
    setView(localStorage.getItem(viewKey) || 'large');
    viewButtons.forEach(button => button.addEventListener('click', () => setView(button.dataset.view)));
    const projectCards = [...grid.querySelectorAll('[data-project]')];
    const searchInput = document.querySelector('[data-filter-search]');
    const statusInput = document.querySelector('[data-filter-status]');
    const techInput = document.querySelector('[data-filter-tech]');
    const sortInput = document.querySelector('[data-filter-sort]');
    const projectCount = document.querySelector('[data-project-count]');
    const applyFilters = () => {
      const query = searchInput.value.trim().toLocaleLowerCase('pt-BR'), status = statusInput.value, tech = techInput.value, sort = sortInput.value;
      const visible = projectCards.filter(card => {
        const text = card.dataset.name.toLocaleLowerCase('pt-BR');
        const match = (!query || text.includes(query)) && (!status || card.dataset.status === status) && (!tech || card.dataset.tech.split('|').includes(tech));
        card.hidden = !match; return match;
      });
      visible.sort((a, b) => sort === 'name' ? a.dataset.name.localeCompare(b.dataset.name, 'pt-BR') : sort === 'oldest' ? a.dataset.date.localeCompare(b.dataset.date) : b.dataset.date.localeCompare(a.dataset.date));
      visible.forEach(card => grid.append(card)); projectCount.textContent = visible.length;
    };
    [searchInput, statusInput, techInput, sortInput].forEach(input => input.addEventListener('input', applyFilters));
    document.querySelector('[data-filter-clear]').addEventListener('click', () => { searchInput.value=''; statusInput.value=''; techInput.value=''; sortInput.value='recent'; applyFilters(); });
    applyFilters();
    document.querySelectorAll('[data-copy-path]').forEach(button => {
      button.addEventListener('click', async () => {
        const path = button.dataset.copyPath;
        try {
          await navigator.clipboard.writeText(path);
        } catch {
          window.prompt('Copie o caminho do projeto:', path);
        }
        const original = button.innerHTML;
        button.textContent = 'caminho copiado';
        window.setTimeout(() => { button.innerHTML = original; }, 1800);
      });
    });
    const key = 'jeffef-project-ideas';
    let ideas = {};
    try { ideas = JSON.parse(localStorage.getItem(key) || '{}'); } catch {}
    const render = (id) => {
      const list = document.querySelector(`[data-idea-list="${id}"]`);
      if (!list) return;
      list.innerHTML = '';
      (ideas[id] || []).forEach((text, index) => {
        const li = document.createElement('li');
        const label = document.createElement('span'); label.textContent = text;
        const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = '×'; remove.setAttribute('aria-label','Remover ideia');
        remove.addEventListener('click', () => { ideas[id].splice(index, 1); localStorage.setItem(key, JSON.stringify(ideas)); render(id); });
        li.append(label, remove); list.append(li);
      });
    };
    document.querySelectorAll('[data-idea-form]').forEach(form => {
      const id = form.dataset.ideaForm; render(id);
      form.addEventListener('submit', event => { event.preventDefault(); const input = form.elements.idea; const value = input.value.trim(); if (!value) return; (ideas[id] ||= []).push(value); localStorage.setItem(key, JSON.stringify(ideas)); input.value = ''; render(id); });
    });
  </script>
</BaseLayout>
