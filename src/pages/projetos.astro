---
<BaseLayout title="projetos — jefferson" description="Projetos, status, entregas e próximos passos de Jefferson.">
  <main class="projects-page">
    <section class="projects-shell projects-hero">
      <div>
        <p class="projects-kicker">painel de bordo</p>
        <h1>Projetos</h1>
        <p>Produtos, ferramentas e experimentos em um só lugar. Abra um cartão para ver o que já está pronto e o que vem depois.</p>
      </div>
      <div class="projects-stats" aria-label="Resumo dos projetos">
        <strong>{projects.length}</strong><span>projetos mapeados</span>
      </div>
    </section>

    <section class="projects-shell projects-toolbar" aria-label="Opções de visualização">
      <span>visualização</span>
      <div class="view-switch" role="group" aria-label="Visualização dos projetos">
        <button type="button" data-view="cards" title="Cards" aria-label="Visualizar em cards"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="8" rx="1"/><rect x="14" y="3" width="7" height="8" rx="1"/><rect x="3" y="15" width="7" height="6" rx="1"/><rect x="14" y="15" width="7" height="6" rx="1"/></svg></button>
        <button type="button" data-view="large" title="Cards grandes" aria-label="Visualizar em cards grandes"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="8" rx="1"/><rect x="3" y="15" width="18" height="6" rx="1"/></svg></button>
        <button type="button" data-view="lines" title="Linhas" aria-label="Visualizar em linhas"><svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r=".8"/><circle cx="3.5" cy="12" r=".8"/><circle cx="3.5" cy="18" r=".8"/></svg></button>
      </div>
    </section>

    <section class="projects-shell projects-grid" data-project-grid data-view="large" aria-label="Lista de projetos">
      {projects.map((project, index) => (
        <details class={`project-board-card accent-${project.color}`} open={index === 0} data-project={project.id}>
          <summary>
            <div class="project-summary-top"><span class="project-kind">{project.kind}</span><span class="project-status"><i></i>{project.status}</span></div>
            <div class="project-title-row"><div class="project-mark">{String(index + 1).padStart(2,'0')}</div><div><h2>{project.name}</h2><p>{project.summary}</p><div class="project-tech" aria-label="Tecnologias utilizadas">{project.tech.map(item => <span>{item}</span>)}</div></div></div>
            <span class="project-expand">ver detalhes <b>⌄</b></span>
          </summary>
          <div class="project-detail">
            <div class="project-links">
              <a href={project.pc} title="Abrir pasta local"><span>▣</span> abrir no PC</a>
              {project.github ? <a href={project.github} target="_blank" rel="noreferrer"><span>↗</span> GitHub</a> : <span class="link-disabled">GitHub não configurado</span>}
            </div>
            <div class="project-columns">
              <section><h3><span class="done-dot">✓</span> O que está pronto</h3><ul>{project.ready.map(item => <li>{item}</li>)}</ul></section>
              <section><h3><span class="road-dot">→</span> Roadmap</h3><ol>{project.roadmap.map(item => <li>{item}</li>)}</ol></section>
            </div>
            <section class="ideas-box">
              <div><h3>Banco de ideias</h3><p>Rascunhos salvos neste navegador.</p></div>
              <form data-idea-form={project.id}><input name="idea" autocomplete="off" placeholder={`Nova ideia para ${project.name}...`} aria-label={`Nova ideia para ${project.name}`} /><button type="submit" aria-label="Adicionar ideia">+</button></form>
              <ul data-idea-list={project.id}></ul>
            </section>
          </div>
        </details>
      ))}
    </section>
  </main>
  <script is:inline>
    const viewKey = 'jeffef-project-view';
    const grid = document.querySelector('[data-project-grid]');
    const viewButtons = document.querySelectorAll('[data-view]');
    const setView = (view) => {
      grid.dataset.view = view;
      viewButtons.forEach(button => {
        const active = button.dataset.view === view;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      localStorage.setItem(viewKey, view);
    };
    setView(localStorage.getItem(viewKey) || 'large');
    viewButtons.forEach(button => button.addEventListener('click', () => setView(button.dataset.view)));
    const key = 'jeffef-project-ideas';
    let ideas = {};
    try { ideas = JSON.parse(localStorage.getItem(key) || '{}'); } catch {}
    const render = (id) => {
      const list = document.querySelector(`[data-idea-list="${id}"]`);
      if (!list) return;
      list.innerHTML = '';
      (ideas[id] || []).forEach((text, index) => {
        const li = document.createElement('li');
        const label = document.createElement('span'); label.textContent = text;
        const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = '×'; remove.setAttribute('aria-label','Remover ideia');
        remove.addEventListener('click', () => { ideas[id].splice(index, 1); localStorage.setItem(key, JSON.stringify(ideas)); render(id); });
        li.append(label, remove); list.append(li);
      });
    };
    document.querySelectorAll('[data-idea-form]').forEach(form => {
      const id = form.dataset.ideaForm; render(id);
      form.addEventListener('submit', event => { event.preventDefault(); const input = form.elements.idea; const value = input.value.trim(); if (!value) return; (ideas[id] ||= []).push(value); localStorage.setItem(key, JSON.stringify(ideas)); input.value = ''; render(id); });
    });
  </script>
</BaseLayout>
